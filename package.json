{
  "name": "melodius",
  "version": "0.1.0",
  "description": "Audio-to-MIDI transcription and piano roll player",
  "type": "module",
  "bin": {
    "melodius": "bin/melodius.js"
  },
  "files": [
    "api.py",
    "app",
    "index.html",
    "vite.config.js",
    "bin",
    "package.json"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "uv run api.py",
    "build": "vite build"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "@xromdev/pianoroll": "^0.5.0",
    "concurrently": "^10.0.6",
    "smplr": "^1.1.0",
    "soundfont2": "^0.5.0",
    "toastify": "^2.0.1",
    "toastify-js": "^1.12.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0"
  }
}
